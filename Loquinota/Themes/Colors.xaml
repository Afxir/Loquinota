<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Material Design 3 color roles.
        Every brush is defined inside a ThemeDictionary so {ThemeResource ...}
        automatically follows the Windows light/dark setting.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================= LIGHT ============================= -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MaterialPrimaryColor">#FF6750A4</Color>
            <Color x:Key="SystemAccentColor">#FF6750A4</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7A65B5</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8E7BC7</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA391D9</Color>
            <Color x:Key="SystemAccentColorDark1">#FF57408F</Color>
            <Color x:Key="SystemAccentColorDark2">#FF46307A</Color>
            <Color x:Key="SystemAccentColorDark3">#FF352165</Color>

            <FontFamily x:Key="MaterialFontFamily">Segoe UI</FontFamily>

            <SolidColorBrush x:Key="MaterialPrimaryBrush" Color="#FF6750A4" />
            <SolidColorBrush x:Key="MaterialOnPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MaterialPrimaryContainerBrush" Color="#FFEADDFF" />
            <SolidColorBrush x:Key="MaterialOnPrimaryContainerBrush" Color="#FF21005D" />
            <SolidColorBrush x:Key="MaterialSecondaryBrush" Color="#FF625B71" />
            <SolidColorBrush x:Key="MaterialOnSecondaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MaterialSecondaryContainerBrush" Color="#FFE8DEF8" />
            <SolidColorBrush x:Key="MaterialOnSecondaryContainerBrush" Color="#FF1D192B" />
            <SolidColorBrush x:Key="MaterialTertiaryContainerBrush" Color="#FFFFD8E4" />
            <SolidColorBrush x:Key="MaterialOnTertiaryContainerBrush" Color="#FF31101D" />

            <SolidColorBrush x:Key="MaterialSurfaceBrush" Color="#FFFEF7FF" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowestBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowBrush" Color="#FFF7F2FA" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerBrush" Color="#FFF3EDF7" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighBrush" Color="#FFECE6F0" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighestBrush" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="MaterialSurfaceVariantBrush" Color="#FFE7E0EC" />
            <SolidColorBrush x:Key="MaterialOnSurfaceBrush" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="MaterialOnSurfaceVariantBrush" Color="#FF49454F" />
            <SolidColorBrush x:Key="MaterialOutlineBrush" Color="#FF79747E" />
            <SolidColorBrush x:Key="MaterialOutlineVariantBrush" Color="#FFCAC4D0" />

            <SolidColorBrush x:Key="MaterialErrorBrush" Color="#FFB3261E" />
            <SolidColorBrush x:Key="MaterialOnErrorBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MaterialErrorContainerBrush" Color="#FFF9DEDC" />
            <SolidColorBrush x:Key="MaterialOnErrorContainerBrush" Color="#FF410E0B" />
            <SolidColorBrush x:Key="MaterialSuccessBrush" Color="#FF386A20" />
            <SolidColorBrush x:Key="MaterialOnSuccessBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MaterialSuccessContainerBrush" Color="#FFC8F0B0" />
            <SolidColorBrush x:Key="MaterialScrimBrush" Color="#FF000000" />

            <SolidColorBrush x:Key="MaterialOverlayHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="MaterialOverlayPressedBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="MaterialOverlaySelectedBrush" Color="#1A6750A4" />
            <SolidColorBrush x:Key="MaterialMicaFallbackBrush" Color="#FFFEF7FF" />

            <!-- Built-in WinUI control resource overrides -> Material tonal surfaces -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFF3EDF7" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFECE6F0" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF3EDF7" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFCAC4D0" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF79747E" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF6750A4" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF79747E" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF79747E" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF79747E" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF79747E" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF6750A4" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7A65B5" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF57408F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFCAC4D0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#006750A4" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF79747E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF79747E" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="ToggleSwitchContentForegroundOn" Color="#FF1D1B20" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF21005D" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFEADDFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFECE6F0" />
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#FF49454F" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#FF6750A4" />
        </ResourceDictionary>

        <!-- ============================== DARK ============================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MaterialPrimaryColor">#FFD0BCFF</Color>
            <Color x:Key="SystemAccentColor">#FFD0BCFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FFDCCBFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFE8DBFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF4EBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FFB9A5F5</Color>
            <Color x:Key="SystemAccentColorDark2">#FFA38EE0</Color>
            <Color x:Key="SystemAccentColorDark3">#FF8D78CB</Color>

            <FontFamily x:Key="MaterialFontFamily">Segoe UI</FontFamily>

            <SolidColorBrush x:Key="MaterialPrimaryBrush" Color="#FFD0BCFF" />
            <SolidColorBrush x:Key="MaterialOnPrimaryBrush" Color="#FF381E72" />
            <SolidColorBrush x:Key="MaterialPrimaryContainerBrush" Color="#FF4F378B" />
            <SolidColorBrush x:Key="MaterialOnPrimaryContainerBrush" Color="#FFEADDFF" />
            <SolidColorBrush x:Key="MaterialSecondaryBrush" Color="#FFCCC2DC" />
            <SolidColorBrush x:Key="MaterialOnSecondaryBrush" Color="#FF332D41" />
            <SolidColorBrush x:Key="MaterialSecondaryContainerBrush" Color="#FF4A4458" />
            <SolidColorBrush x:Key="MaterialOnSecondaryContainerBrush" Color="#FFE8DEF8" />
            <SolidColorBrush x:Key="MaterialTertiaryContainerBrush" Color="#FF633B48" />
            <SolidColorBrush x:Key="MaterialOnTertiaryContainerBrush" Color="#FFFFD8E4" />

            <SolidColorBrush x:Key="MaterialSurfaceBrush" Color="#FF141218" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowestBrush" Color="#FF0F0D13" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowBrush" Color="#FF1D1B20" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerBrush" Color="#FF211F26" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighBrush" Color="#FF2B2930" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighestBrush" Color="#FF36343B" />
            <SolidColorBrush x:Key="MaterialSurfaceVariantBrush" Color="#FF49454F" />
            <SolidColorBrush x:Key="MaterialOnSurfaceBrush" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="MaterialOnSurfaceVariantBrush" Color="#FFCAC4D0" />
            <SolidColorBrush x:Key="MaterialOutlineBrush" Color="#FF938F99" />
            <SolidColorBrush x:Key="MaterialOutlineVariantBrush" Color="#FF49454F" />

            <SolidColorBrush x:Key="MaterialErrorBrush" Color="#FFF2B8B5" />
            <SolidColorBrush x:Key="MaterialOnErrorBrush" Color="#FF601410" />
            <SolidColorBrush x:Key="MaterialErrorContainerBrush" Color="#FF8C1D18" />
            <SolidColorBrush x:Key="MaterialOnErrorContainerBrush" Color="#FFF9DEDC" />
            <SolidColorBrush x:Key="MaterialSuccessBrush" Color="#FFB7F397" />
            <SolidColorBrush x:Key="MaterialOnSuccessBrush" Color="#FF0A3900" />
            <SolidColorBrush x:Key="MaterialSuccessContainerBrush" Color="#FF2A4A1D" />
            <SolidColorBrush x:Key="MaterialScrimBrush" Color="#FF000000" />

            <SolidColorBrush x:Key="MaterialOverlayHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="MaterialOverlayPressedBrush" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="MaterialOverlaySelectedBrush" Color="#33D0BCFF" />
            <SolidColorBrush x:Key="MaterialMicaFallbackBrush" Color="#FF141218" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#FF2B2930" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF36343B" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF36343B" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF211F26" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF49454F" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF938F99" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFD0BCFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FF36343B" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF938F99" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF938F99" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF938F99" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF938F99" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFD0BCFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFEADDFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFB9A5F5" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF36343B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#00D0BCFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF938F99" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF381E72" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFCAC4D0" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="ToggleSwitchContentForegroundOn" Color="#FFE6E0E9" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFE6E0E9" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFEADDFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF4F378B" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FF2B2930" />
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#FFCAC4D0" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#FFD0BCFF" />
        </ResourceDictionary>

        <!-- High contrast keeps Material roles wired to system colours. -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="MaterialPrimaryColor">#FFD0BCFF</Color>
            <Color x:Key="SystemAccentColor">#FFD0BCFF</Color>
            <FontFamily x:Key="MaterialFontFamily">Segoe UI</FontFamily>

            <SolidColorBrush x:Key="MaterialPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MaterialOnPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="MaterialPrimaryContainerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MaterialOnPrimaryContainerBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="MaterialSecondaryBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="MaterialOnSecondaryBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="MaterialSecondaryContainerBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="MaterialOnSecondaryContainerBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="MaterialTertiaryContainerBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="MaterialOnTertiaryContainerBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="MaterialSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowestBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerLowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceContainerHighestBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSurfaceVariantBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialOnSurfaceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialOnSurfaceVariantBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialOutlineVariantBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialOnErrorBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialErrorContainerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialOnErrorContainerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MaterialOnSuccessBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialSuccessContainerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MaterialScrimBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="MaterialOverlayHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="MaterialOverlayPressedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="MaterialOverlaySelectedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="MaterialMicaFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
