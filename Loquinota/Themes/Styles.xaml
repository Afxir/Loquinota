<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ TYPE SCALE ============================ -->
    <Style x:Key="MaterialHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style x:Key="MaterialSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MaterialTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MaterialSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MaterialBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="MaterialCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MaterialLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialPrimaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================== BUTTONS ============================= -->
    <Style x:Key="MaterialButtonBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressedOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="HoverOverlay"
                                Background="{ThemeResource MaterialOverlayHoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PressedOverlay"
                                Background="{ThemeResource MaterialOverlayPressedBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaterialFilledButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MaterialPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnPrimaryBrush}" />
    </Style>

    <Style x:Key="MaterialTonalButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MaterialSecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSecondaryContainerBrush}" />
    </Style>

    <Style x:Key="MaterialOutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MaterialOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="MaterialTextButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialPrimaryBrush}" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="MaterialDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource MaterialErrorBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnErrorBrush}" />
    </Style>

    <Style x:Key="MaterialIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceVariantBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- Default Button becomes a Material filled button. -->
    <Style TargetType="Button" BasedOn="{StaticResource MaterialFilledButtonStyle}" />

    <!-- =============================== CARDS ============================== -->
    <Style x:Key="MaterialCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MaterialSurfaceContainerLowBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MaterialOutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="MaterialTonalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MaterialSecondaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="MaterialSheetStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MaterialSurfaceContainerBrush}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BorderBrush" Value="{ThemeResource MaterialOutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="MaterialDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource MaterialOutlineVariantBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MaterialPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MaterialSecondaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================== INPUTS ============================== -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource MaterialPrimaryBrush}" />
    </Style>

    <Style TargetType="RichEditBox" BasedOn="{StaticResource DefaultRichEditBoxStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
    </Style>

    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MaterialFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource MaterialOnSurfaceBrush}" />
    </Style>

    <Style x:Key="MaterialProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource MaterialPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource MaterialSurfaceContainerHighestBrush}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- ========================== NAVIGATION ITEMS ======================== -->
    <!-- NavigationViewItem has no keyed default style in WinUI, so its Material
         sizing is applied with inline properties on each item instead of a Style. -->

    <Style x:Key="MaterialViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
