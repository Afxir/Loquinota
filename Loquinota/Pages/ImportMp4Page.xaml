<Page
    x:Class="Loquinota.Pages.ImportMp4Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.WinUI3"
    xmlns:local="using:Loquinota.Pages">

    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <!-- ============================== HEADER ============================== -->
            <StackPanel Spacing="4">
                <TextBlock Text="Import MP4" Style="{StaticResource MaterialHeadlineTextStyle}" />
                <TextBlock Text="Pick a video, extract its audio locally and turn the speech into notes. Nothing leaves this PC."
                           Style="{StaticResource MaterialBodyTextStyle}"
                           Foreground="{ThemeResource MaterialOnSurfaceVariantBrush}" />
            </StackPanel>

            <!-- ============================== STATUS ============================== -->
            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Title="Status" />

            <!-- =========================== MODEL READY =========================== -->
            <InfoBar x:Name="ModelInfoBar"
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="False"
                     Title="Speech model not ready"
                     Message="A Whisper model is required to transcribe audio." />

            <StackPanel x:Name="ModelProgressPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="ModelProgressText" Text="Preparing the speech model…"
                           Style="{StaticResource MaterialCaptionTextStyle}" />
                <ProgressBar x:Name="ModelDownloadBar"
                             Style="{StaticResource MaterialProgressBarStyle}"
                             Minimum="0" Maximum="100" Value="0" />
            </StackPanel>

            <!-- =========================== SPEECH MODEL ========================== -->
            <Border Style="{StaticResource MaterialCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="SPEECH MODEL" Style="{StaticResource MaterialLabelTextStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ModelCombo"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="240"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ModelCombo_SelectionChanged" />

                        <Button x:Name="DownloadModelButton"
                                Grid.Column="1"
                                Style="{StaticResource MaterialTonalButtonStyle}"
                                VerticalAlignment="Center"
                                Click="DownloadModel_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Download" Width="18" Height="18"
                                                 Foreground="{ThemeResource MaterialOnSecondaryContainerBrush}" />
                                <TextBlock x:Name="DownloadModelLabel" Text="Download model" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="ModelStatusText"
                               Text="Checking the speech model…"
                               Style="{StaticResource MaterialCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ============================ PICK FILE ============================ -->
            <Border Style="{StaticResource MaterialCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="SOURCE FILE" Style="{StaticResource MaterialLabelTextStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChooseFileButton"
                                Style="{StaticResource MaterialOutlinedButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ChooseFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="FolderOpen" Width="18" Height="18"
                                                 Foreground="{ThemeResource MaterialPrimaryBrush}" />
                                <TextBlock Text="Choose MP4" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedFileText"
                                       Text="No file selected"
                                       Style="{StaticResource MaterialBodyTextStyle}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectedFileMetaText"
                                       Text="MP4 video — the soundtrack is converted to 16 kHz mono WAV."
                                       Style="{StaticResource MaterialCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartImportButton"
                                Style="{StaticResource MaterialFilledButtonStyle}"
                                IsEnabled="False"
                                Click="StartImport_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AutoAwesome" Width="18" Height="18"
                                                 Foreground="{ThemeResource MaterialOnPrimaryBrush}" />
                                <TextBlock Text="Import &amp; transcribe" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CancelImportButton"
                                Style="{StaticResource MaterialTextButtonStyle}"
                                Visibility="Collapsed"
                                Click="CancelImport_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Close" Width="18" Height="18"
                                                 Foreground="{ThemeResource MaterialPrimaryBrush}" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================= PROGRESS ============================ -->
            <Border x:Name="ProgressCard"
                    Style="{StaticResource MaterialCardStyle}"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhaseText"
                                   Text="Preparing FFmpeg…"
                                   Style="{StaticResource MaterialSubtitleTextStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PhaseEtaText"
                                   Grid.Column="1"
                                   Text=""
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialCaptionTextStyle}" />
                    </Grid>

                    <ProgressBar x:Name="WorkBar"
                                 Style="{StaticResource MaterialProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0"
                                 IsIndeterminate="True" />

                    <TextBlock x:Name="PhaseDetailText"
                               Text=""
                               Style="{StaticResource MaterialCaptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ============================== REVIEW ============================= -->
            <StackPanel x:Name="ReviewPanel" Spacing="16" Visibility="Collapsed">

                <Border Style="{StaticResource MaterialTonalCardStyle}" Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{ThemeResource MaterialPrimaryContainerBrush}"
                                VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="CheckCircle" Width="22" Height="22"
                                             HorizontalAlignment="Center"
                                             Foreground="{ThemeResource MaterialOnPrimaryContainerBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Transcription ready" Style="{StaticResource MaterialSubtitleTextStyle}" />
                            <TextBlock x:Name="ReviewSummaryText" Text=""
                                       Style="{StaticResource MaterialCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource MaterialCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TITLE" Style="{StaticResource MaterialLabelTextStyle}" />
                        <TextBox x:Name="TitleBox" PlaceholderText="Session title" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaterialCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRANSCRIPT" Style="{StaticResource MaterialLabelTextStyle}" />
                            <TextBlock x:Name="TranscriptStatsText" Grid.Column="1" Text=""
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MaterialCaptionTextStyle}" />
                        </Grid>
                        <TextBox x:Name="TranscriptBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="280"
                                 VerticalContentAlignment="Top"
                                 IsSpellCheckEnabled="True"
                                 TextChanged="Review_TextChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaterialCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NOTES" Style="{StaticResource MaterialLabelTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Generated summary — edit freely"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MaterialCaptionTextStyle}" />
                        </Grid>
                        <TextBox x:Name="NotesBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 IsSpellCheckEnabled="True" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveSessionButton"
                            Style="{StaticResource MaterialFilledButtonStyle}"
                            Click="SaveSession_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18"
                                             Foreground="{ThemeResource MaterialOnPrimaryBrush}" />
                            <TextBlock x:Name="SaveSessionLabel" Text="Save session" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportButton"
                            Style="{StaticResource MaterialOutlinedButtonStyle}"
                            Click="Export_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Download" Width="18" Height="18"
                                             Foreground="{ThemeResource MaterialPrimaryBrush}" />
                            <TextBlock Text="Export TXT" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ViewSessionButton"
                            Style="{StaticResource MaterialTextButtonStyle}"
                            Visibility="Collapsed"
                            Click="ViewSession_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="OpenInNew" Width="18" Height="18"
                                             Foreground="{ThemeResource MaterialPrimaryBrush}" />
                            <TextBlock Text="Open saved session" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ResetButton"
                            Style="{StaticResource MaterialTextButtonStyle}"
                            Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Refresh" Width="18" Height="18"
                                             Foreground="{ThemeResource MaterialPrimaryBrush}" />
                            <TextBlock Text="Reset" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
