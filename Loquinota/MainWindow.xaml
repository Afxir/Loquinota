<Window
    x:Class="Loquinota.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.WinUI3"
    Title="loquinota">

    <Grid x:Name="RootGrid" Background="{ThemeResource MaterialSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,6,150,6" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Waveform" Width="22" Height="22"
                                 Foreground="{ThemeResource MaterialPrimaryBrush}"
                                 VerticalAlignment="Center" />
                <TextBlock Text="loquinota" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource MaterialOnSurfaceBrush}" VerticalAlignment="Center" />
                <Border Style="{StaticResource MaterialPillStyle}"
                        Background="{ThemeResource MaterialPrimaryContainerBrush}"
                        Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="LOCAL AI NOTES" FontSize="10" CharacterSpacing="80"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource MaterialOnPrimaryContainerBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="268"
                        CompactPaneLength="64"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HistoryNavItem" Tag="history"
                                    CornerRadius="14" Margin="8,2" Padding="12,0" MinHeight="44" FontSize="14" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <mi:MaterialIcon Kind="History" Width="20" Height="20"
                                         Foreground="{ThemeResource NavigationViewItemIconForeground}" />
                        <TextBlock Text="History" VerticalAlignment="Center"
                                   Foreground="{ThemeResource NavigationViewItemForeground}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem x:Name="LiveNavItem" Tag="live"
                                    CornerRadius="14" Margin="8,2" Padding="12,0" MinHeight="44" FontSize="14" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <mi:MaterialIcon Kind="Microphone" Width="20" Height="20"
                                         Foreground="{ThemeResource NavigationViewItemIconForeground}" />
                        <TextBlock Text="Live Capture" VerticalAlignment="Center"
                                   Foreground="{ThemeResource NavigationViewItemForeground}" />
                    </StackPanel>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ImportNavItem" Tag="import"
                                    CornerRadius="14" Margin="8,2" Padding="12,0" MinHeight="44" FontSize="14" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <mi:MaterialIcon Kind="MovieOpen" Width="20" Height="20"
                                         Foreground="{ThemeResource NavigationViewItemIconForeground}" />
                        <TextBlock Text="Import MP4" VerticalAlignment="Center"
                                   Foreground="{ThemeResource NavigationViewItemForeground}" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="16,0,16,16" Spacing="4">
                    <Border Style="{StaticResource MaterialDividerStyle}" Margin="0,0,0,10" />
                    <TextBlock Text="Private by design" Style="{StaticResource MaterialCaptionTextStyle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Audio and AI stay on this PC."
                               Style="{StaticResource MaterialCaptionTextStyle}" Opacity="0.75" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>

